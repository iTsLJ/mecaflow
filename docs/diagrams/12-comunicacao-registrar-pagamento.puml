@startuml
title Diagrama de Comunicação — Realização de UC-16 (Registrar Pagamento)
skinparam shadowing false

object "Atendente" as A <<ator>>
object ":PagamentoController" as ctrl
object ":PagamentoService" as svc
object ":OrdemServicoRepository" as osRepo
object ":PagamentoRepository" as pagRepo

A -right-> ctrl : 1: POST /api/pagamentos\n(ordemServicoId, forma, parcelas)
ctrl -right-> svc : 2: registrar(dto)
svc -down-> osRepo : 3: findById(ordemServicoId)\n6: save(os [ENTREGUE])
svc -> svc : 4: validarConcluida(os)
svc -down-> pagRepo : 5: save(pagamento [PAGO])
ctrl ..> A : 7: 201 Created (PagamentoResponse)
@enduml
