@startuml casos-de-uso
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome
title MecaFlow — Diagrama de Casos de Uso

actor "Administrador" as Admin
actor "Atendente" as Atendente
actor "Mecânico" as Mecanico

rectangle "MecaFlow" {
  usecase "Autenticar no sistema" as UC0
  usecase "Gerenciar usuários" as UC1
  usecase "Gerenciar catálogo de serviços" as UC2
  usecase "Gerenciar fornecedores" as UC3
  usecase "Gerenciar peças e estoque" as UC4
  usecase "Gerenciar clientes" as UC5
  usecase "Gerenciar veículos" as UC6
  usecase "Agendar serviço" as UC7
  usecase "Emitir orçamento" as UC8
  usecase "Registrar decisão do orçamento" as UC9
  usecase "Abrir ordem de serviço" as UC10
  usecase "Atribuir mecânico" as UC11
  usecase "Atualizar status da OS" as UC12
  usecase "Lançar serviços e peças na OS" as UC13
  usecase "Concluir ordem de serviço" as UC14
  usecase "Registrar pagamento" as UC15
  usecase "Consultar histórico do veículo" as UC16
  usecase "Emitir relatórios gerenciais" as UC17
  usecase "Calcular valor total" as UC18
  usecase "Dar baixa no estoque" as UC19
  usecase "Gerar alerta de\nestoque mínimo" as UC20
  usecase "Aplicar desconto" as UC21
}

Admin --> UC0
Atendente --> UC0
Mecanico --> UC0

Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC17

Atendente --> UC4
Atendente --> UC5
Atendente --> UC6
Atendente --> UC7
Atendente --> UC8
Atendente --> UC9
Atendente --> UC10
Atendente --> UC11
Atendente --> UC15
Atendente --> UC16

Mecanico --> UC12
Mecanico --> UC13
Mecanico --> UC14
Mecanico --> UC16

' ---------- INCLUDE: comportamento obrigatório e reutilizado ----------
UC8  .> UC18 : <<include>>
UC14 .> UC18 : <<include>>

' ---------- EXTEND: comportamento condicional (aponta para o caso base) ----------
UC19 .> UC13 : <<extend>>
UC20 .> UC19 : <<extend>>
UC21 .> UC15 : <<extend>>

note bottom of UC10
  Pré-condição: existir orçamento com
  status APROVADO para o veículo.
  (pré-condição não é <<include>>)
end note

legend right
  |= Relação <<extend>> |= Condição de execução |
  | Dar baixa no estoque -> Lançar serviços e peças na OS | item lançado é do tipo PEÇA |
  | Gerar alerta de estoque mínimo -> Dar baixa no estoque | saldo fica abaixo do estoque mínimo |
  | Aplicar desconto -> Registrar pagamento | atendente concede desconto |
endlegend

@enduml
